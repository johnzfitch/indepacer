version: "0.2.1"
date-released: "2026-03-07"
license: MIT
repository-code: https://github.com/johnzfitch/pacer-cli
url: https://pypi.org/project/pacer-cli/
keywords:
  - PACER
  - federal courts
  - legal research
  - docket
  - CM/ECF
  - PCL
  - court records
  - litigation
  - legal technology
